<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="GM.Exceptions" Version="1.2.1" />
      <!-- Replaces a hard-coded path to a shared-framework DLL. -->
      <PackageReference Include="Microsoft.Extensions.Localization.Abstractions" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Update="Resources\StringResource.resx">
        <Generator>PublicResXFileCodeGenerator</Generator>
        <LastGenOutput>StringResource.Designer.cs</LastGenOutput>
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </EmbeddedResource>
      <EmbeddedResource Update="Resources\GMExceptionsResource.resx">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        <Generator>PublicResXFileCodeGenerator</Generator>
      </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Resources\StringResource.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>StringResource.resx</DependentUpon>
      </Compile>
    </ItemGroup>

</Project>
